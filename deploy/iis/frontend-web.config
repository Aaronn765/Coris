<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for the Next.js server and the ASP.NET Core API.
  Prerequisite: install IIS URL Rewrite and Application Request Routing (ARR),
  then enable the ARR proxy at server level.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Coris API root" stopProcessing="true">
          <match url="^api$" />
          <action type="Rewrite" url="http://127.0.0.1:5000/api" />
        </rule>
        <rule name="Coris API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/api/{R:1}" />
        </rule>
        <rule name="Coris Next.js" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
